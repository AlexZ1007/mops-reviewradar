SUPABASE_URL=http://127.0.0.1:64321
# Backend: apikey header for Supabase Auth calls made by FastAPI /auth/*.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only for legacy HS256 projects (local Supabase CLI default). Leave empty when using asymmetric signing keys.
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:64322/postgres
API_BASE_URL=http://127.0.0.1:8000
# Frontend: lifetime of the HttpOnly refresh-token cookie (sliding: renewed on every token refresh).
SESSION_COOKIE_DAYS=7
